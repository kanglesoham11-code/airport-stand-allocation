# Aleph Airport Stand Allocation — Environment Variables
# Copy this file to .env and fill in your values.
# See config.py for detailed validation rules.

# --- Authentication (required, min 32 chars each, comma-separated) ---
API_KEYS=changeme-your-real-key-here-min-32-characters

# --- Solver & Algorithm ---
ALLOCATOR=cpsat
BUFFER_MINUTES=15
SOLVER_TIME_LIMIT_SECONDS=10

# --- CORS (comma-separated origins allowed by the browser) ---
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- Logging ---
LOG_LEVEL=INFO

# --- Database ---
DB_PATH=data/allocation.db

# --- Proxy (set to true behind a reverse proxy that sets X-Forwarded-For) ---
TRUST_PROXY_HEADERS=false
